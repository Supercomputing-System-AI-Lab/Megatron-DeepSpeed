echo "RUN_PLANNER: $RUN_PLANNER"
echo "COLLECT_PROFILING_CACHE: $COLLECT_PROFILING_CACHE"

# --- Profiling-cache-collection overrides -----------------------------------
# When COLLECT_PROFILING_CACHE=true, this run populates planner_profiling_cache/
# via analyze_log.py --profiling. To produce a clean log for that extraction:
#   (1) PP_SIZE=1 so the existing PP conditionals select WALL_CLOCK_BREAKDOWN=true
#       and --no-pipeline-parallel (required for per-module timer lines).
#   (2) TRITON_DISABLE_CACHE=1 so first-call compile timings are observed.
#   (3) profile_memory=True for memory-balanced planner data.
#   (4) RUN_PLANNER=false — producer path must not also invoke the consumer,
#       which would try to read a cache that doesn't exist yet.
#   (5) Skip the Triton cache warmup (contradicts TRITON_DISABLE_CACHE=1).
#   (6) Pass --profiling to analyze_log.py so write_profile_json() runs.
if [[ "$COLLECT_PROFILING_CACHE" == "true" ]]; then
    PP_SIZE=1
    RUN_PLANNER="false"
    PROFILING_SKIP_CACHE_WARM=1
    ANALYZE_LOG_PROFILING_FLAG="--profiling"
else
    PROFILING_SKIP_CACHE_WARM=0
    ANALYZE_LOG_PROFILING_FLAG=""
fi

which python


JOB_DIR="logs/job_${SLURM_JOB_ID}_pp{{PP_SIZE}}_ep{{EP_PARALLEL_SIZE}}_{{MOE_TYPE}}_ckpt_{{ACTIVATION_CHECKPOINT}}_planner_{{RUN_PLANNER}}"
echo "JOB_DIR: {JOB_DIR}"

export DYNAMIC_CHECKPOINT=$DYNAMIC_CHECKPOINT
export UNEVEN_PP=$UNEVEN_PP


# ================================================== Model & Data Setup =============================================================
export LD_PRELOAD="/usr/lib64/libcrypto.so /usr/lib64/libssh.so.4 /usr/lib64/libssl.so.1.1"
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TORCH_EXTENSIONS_DIR=$PWD/deepspeed
export HF_HOME=$PWD/hfdata
export OMP_NUM_THREADS=1

export CHECKPOINT_PATH=checkpoint/small
export VOCAB_FILE=../data/gpt2-vocab.json
export MERGE_FILE=../data/gpt2-merges.txt
export DATA_PATH=../data/my-gpt2_text_document

DIR=`pwd`
mkdir -p logs

# -------------------------------------------------------------------------------------------
# Get model config
CONFIG_VARS=$(python3 ../utils/model_registry.py get_vars --model_size "${MODEL_SIZE}")
if [ $? -ne 0 ]; then
    echo "Error: Model size '${MODEL_SIZE}' not found in registry."
    exit 1
fi

# Evaluate the output to set the Bash variables
eval "$CONFIG_VARS"

echo "Model Config Loaded for ${MODEL_SIZE}:"
echo "  HIDDEN_SIZE: $HIDDEN_SIZE"
echo "  FFN_HIDDEN_SIZE:    $FFN_HIDDEN_SIZE"
echo "  NUM_LAYERS: $NUM_LAYERS"
echo "  NUM_ATTN_HEADS: $NUM_ATTN_HEADS"
echo "  EP_SIZE: $EP_SIZE"
echo "  topk: $topk"
echo "  SEQ_LEN: $SEQ_LEN"
# -------------------------------------------------------------------------------------------
# ================================================== END of Model & Data Setup =============================================================


# ================================================== Megatron Setup =============================================================
GLOBAL_BATCH_SIZE=$(( NUM_BATCHES * BATCH_SIZE * (TOTAL_GPUS / PP_SIZE / MP_SIZE) ))
echo "GLOBAL_BATCH_SIZE=$GLOBAL_BATCH_SIZE"

# --- Static Training Parameters ---
LR=1.2e-4
MIN_LR=1.0e-6
TRAIN_TOKENS=300000000000
EXIT_DURATION=30000000
WARMUP_TOKENS=375000000
LR_DECAY_TOKENS=300000000000
MLC=0.01
MOE_TRAIN_CAP_FACTOR=1.0
MOE_EVAL_CAP_FACTOR=1.0
MOE_MIN_CAP=4
MOE_DROP_TOKEN="true"
CL_ENABLED="false"
CL_START_SEQLEN=80
CL_AVG_SEQLEN=$(( (CL_START_SEQLEN + SEQ_LEN) / 2 ))
CL_TOKENS=60
CL_TOKENS=$((CL_TOKENS * 1000000000))
CL_STEP=$(( CL_TOKENS / (GLOBAL_BATCH_SIZE * CL_AVG_SEQLEN) ))
LOG_INTERVAL=1
EVAL_ITERS=5
EVAL_INTERVAL=100
SAVE_INTERVAL=50
INIT_STD=0.014

# --- Output and Data Configs ---
current_time=$(date "+%Y.%m.%d-%H.%M.%S")
host="${HOSTNAME}"
NAME="gpt-${MODEL_SIZE}B-lr-${LR}-minlr-${MIN_LR}-bs-${GLOBAL_BATCH_SIZE}-gpus-${TOTAL_GPUS}-mp-${MP_SIZE}-pp-${PP_SIZE}-test"
if [[ $EP_SIZE -gt 1 ]]; then
    NAME="${NAME}-ep-${EP_SIZE}-mlc-${MLC}-cap-${MOE_TRAIN_CAP_FACTOR}-drop-${MOE_DROP_TOKEN}"
fi
if [ "${CL_ENABLED}" = "true" ]; then
    NAME="${NAME}-cl-${CL_START_SEQLEN}-${CL_STEP}"
fi

OUTPUT_BASEPATH=$DIR/output
mkdir -p "${OUTPUT_BASEPATH}/tensorboard/"
mkdir -p "${OUTPUT_BASEPATH}/checkpoint/"
mkdir -p "${OUTPUT_BASEPATH}/log/"
TENSORBOARD_DIR="${OUTPUT_BASEPATH}/tensorboard/${NAME}_${host}_${current_time}"
mkdir -p ${TENSORBOARD_DIR}

# --- Megatron & Deepspeed Options ---
data_options=" \
         --vocab-file ${VOCAB_FILE} \
         --merge-file ${MERGE_FILE} \
         --data-path ${DATA_PATH}"

megatron_options=" \
        --moe-expert-parallel-size ${EP_PARALLEL_SIZE} \
        --num-experts ${EP_SIZE} \
        --moe-loss-coeff ${MLC} \
        --moe-train-capacity-factor ${MOE_TRAIN_CAP_FACTOR} \
        --moe-eval-capacity-factor ${MOE_EVAL_CAP_FACTOR} \
        --moe-min-capacity ${MOE_MIN_CAP} \
        --override-opt_param-scheduler \
        --adam-beta1 0.9 \
        --adam-beta2 0.95 \
        --tensor-model-parallel-size ${MP_SIZE} \
        --init-method-std ${INIT_STD} \
        --lr-decay-tokens ${LR_DECAY_TOKENS} \
        --lr-warmup-tokens ${WARMUP_TOKENS} \
        --micro-batch-size ${BATCH_SIZE} \
        --exit-duration-in-mins ${EXIT_DURATION} \
        --global-batch-size ${GLOBAL_BATCH_SIZE} \
        --num-layers ${NUM_LAYERS} \
        --hidden-size ${HIDDEN_SIZE} \
        --ffn-hidden-size ${FFN_HIDDEN_SIZE} \
        --num-attention-heads ${NUM_ATTN_HEADS} \
        --seq-length ${SEQ_LEN} \
        --max-position-embeddings ${SEQ_LEN} \
        --train-tokens ${TRAIN_TOKENS} \
        --train-iters ${TRAIN_ITERS} \
        --lr ${LR} \
        --min-lr ${MIN_LR} \
        --lr-decay-style cosine \
        --split 98,2,0 \
        --log-interval ${LOG_INTERVAL} \
        --eval-interval ${EVAL_INTERVAL} \
        --eval-iters ${EVAL_ITERS} \
        --save-interval ${SAVE_INTERVAL} \
        --weight-decay 0.1 \
        --clip-grad 1.0 \
        --hysteresis 2 \
        --num-workers 0 \
        --fp16 \
        --tensorboard-queue-size 1 \
        --log-timers-to-tensorboard \
        --log-batch-size-to-tensorboard \
        --log-validation-ppl-to-tensorboard \
        --tensorboard-dir ${TENSORBOARD_DIR} \
        --eval-iters 0 \
        --moe-train-capacity-factor 1.25 \
	    --expert-interval 1 \
	    --topk $topk \
        --use-flash-attn-v2 \
	--use-rotary-position-embeddings"
    # --using-torchrun \

        # --use-flash-attn-v2 \
        
# --- Conditional Logic ---
# Set DeepSpeed flags and other settings based on whether this is a PP run.
if [[ ${PP_SIZE} -gt 1 ]]; then
    WALL_CLOCK_BREAKDOWN="false"
    export WALL_CLOCK_BREAKDOWN="false"
else
    
    # If enabling profiling caches 
    if [[ "$COLLECT_PROFILING_CACHE" == "true" ]]; then
        WALL_CLOCK_BREAKDOWN="true"
        export WALL_CLOCK_BREAKDOWN="true"
    else 
        WALL_CLOCK_BREAKDOWN="false"
        export WALL_CLOCK_BREAKDOWN="false"
        # WALL_CLOCK_BREAKDOWN="true"
        # export WALL_CLOCK_BREAKDOWN="true"
    fi 
fi

if [[ "${MOE_TYPE}" == "X-MOE" ]]; then
    megatron_options="${megatron_options} --use-uneven-all-to-all --use-pft"
    # megatron_options="${megatron_options} --use-uneven-all-to-all --use-pft --use-rbd"
elif [[ "${MOE_TYPE}" == "ELMOE-3D" ]]; then
    megatron_options="${megatron_options} --use-uneven-all-to-all --use-pft"

elif [[ "${MOE_TYPE}" == "ELMOE-GroupedGEMM-triton" ]]; then
    megatron_options="${megatron_options} --use-uneven-all-to-all --use-pft --use-groupedGEMM --use-triton"
    export USE_TRITON_GROUPGEMM="True"

elif [[ "${MOE_TYPE}" == "ELMOE-GroupedGEMM-primus" ]]; then
    export USE_AITER_GROUPGEMM=True 
    megatron_options="${megatron_options} --use-uneven-all-to-all --use-pft --use-groupedGEMM --no-bias-gelu-fusion --disable-bias-linear"

elif [[ "${MOE_TYPE}" == "TED-MOE" ]]; then
    megatron_options="${megatron_options} --enable-expert-tensor-parallelism"

elif [[ "${MOE_TYPE}" == "TUTEL-MOE" ]]; then
    megatron_options="${megatron_options} --use-tutel"
fi


if [ "${ACTIVATION_CHECKPOINT}" = "true" ]; then
    megatron_options="${megatron_options} --checkpoint-activations"
    megatron_options="${megatron_options} --checkpoint-num-layers $CHECKPOINT_NUM_LAYERS"
fi
if [[ $EP_SIZE -gt 1 ]]; then
    megatron_options="${megatron_options} --create-moe-param-group"
fi
if [ "${MOE_DROP_TOKEN}" = "false" ]; then
    megatron_options="${megatron_options} --disable-moe-token-dropping"
fi
# ================================================== END of Megatron Setup =============================================================


# ================================================== DeepSpeed Setup =============================================================
# WALL_CLOCK_BREAKDOWN="false"
template_json="../ds_config_gpt_TEMPLATE.json"
# config_json="ds_config_gpt_Zero0_${NAME}.json"
config_dir="temp_ds_json"
config_json="${config_dir}/ds_config_gpt_Zero0_${NAME}.json"
# Create temp_ds_json directory if it doesn't exist
mkdir -p "${config_dir}"

sed "s/CONFIG_BATCH_SIZE/${GLOBAL_BATCH_SIZE}/" ${template_json} \
    | sed "s/CONFIG_MBSIZE/${BATCH_SIZE}/" \
    | sed "s/LOG_INTERVAL/${LOG_INTERVAL}/" \
    | sed "s/ZERO_STAGE/{{ZERO}}/" \
    | sed "s/PRESCALE_GRAD/false/" \
    | sed "s/CONFIG_FP16_ENABLED/true/" \
    | sed "s/CONFIG_BF16_ENABLED/false/" \
    | sed "s/CONFIG_CL_ENABLED/${CL_ENABLED}/" \
    | sed "s/CONFIG_CL_MIN/${CL_START_SEQLEN}/" \
    | sed "s/CONFIG_CL_MAX/${SEQ_LEN}/" \
    | sed "s/CONFIG_CL_DURATION/${CL_STEP}/" \
    | sed "s/WALL_CLOCK_BREAKDOWN/${WALL_CLOCK_BREAKDOWN}/" \
    > ${config_json}

deepspeed_options=" --deepspeed --deepspeed_config ${config_json}"
if [[ $PP_SIZE -gt 1 ]]; then
    deepspeed_options=" ${deepspeed_options} --pipeline-model-parallel-size ${PP_SIZE}"
else
    deepspeed_options=" ${deepspeed_options} --no-pipeline-parallel"
fi

if [ "${ACTIVATION_CHECKPOINT}" = "true" ]; then
    deepspeed_options="${deepspeed_options} --deepspeed-activation-checkpointing"
fi
# ================================================== END of DeepSpeed Setup =============================================================


# ================================================== Setup Moving Cache to prevent IO =============================================================
# # export TRITON_DISABLE_CACHE=1
# # export TRITON_CACHE_DIR="/lustre/orion/gen150/scratch/zixianw4/.triton/cache/"
# TMP_TRITON_DIR="/tmp/triton_cache_${SLURM_JOB_ID}"
# TRITON_CACHE_DIR="/tmp/triton_cache_${SLURM_JOB_ID}"
# mkdir -p ${TRITON_CACHE_DIR}
PERSISTENT_TRITON_CACHE="/lustre/orion/gen150/scratch/zixianw4/.triton/cache"
TMP_TRITON_DIR="/tmp/triton_cache_${SLURM_JOB_ID}"
export TRITON_CACHE_DIR="${TMP_TRITON_DIR}"

if [[ "${PROFILING_SKIP_CACHE_WARM}" != "1" ]]; then
    echo "--- Warming Triton cache on all nodes at: $(date '+%F %T') ---"
    srun -N ${NODES} -n ${NODES} --ntasks-per-node=1 \
        bash cache_setup.sh ${PERSISTENT_TRITON_CACHE} ${TMP_TRITON_DIR}
    echo "--- Cache warm done at: $(date '+%F %T') ---"
else
    echo "--- Profiling-cache-collection run: skipping Triton cache warm (TRITON_DISABLE_CACHE=1) ---"
fi
# ================================================== END of Setup Moving Cache =============================================================


# ================================================== Frontier Global Env Var Setup =============================================================
# --- Execution Logic ---
export CUDA_DEVICE_MAX_CONNECTIONS=1
# Try to mitigate triton groupgemm's effect for 4 arenas per thread instead of default 8. 
# export MALLOC_ARENA_MAX=4


export RANK=$SLURM_PROCID
export WORLD_SIZE=$SLURM_NTASKS
export LOCAL_RANK=$SLURM_LOCALID


export HIGH_SPEED_INTERFACE="hsn0"
export FI_MR_CACHE_MONITOR=kdreg2     # Required to avoid a deadlock.
# export FI_CXI_DEFAULT_CQ_SIZE=131072  # Ask the network stack to allocate additional space to process message completions.
# export FI_CXI_DEFAULT_TX_SIZE=2048    # Ask the network stack to allocate additional space to hold pending outgoing messages.
export FI_CXI_DEFAULT_CQ_SIZE=524288
export FI_CXI_DEFAULT_TX_SIZE=16384
# export FI_CXI_DEFAULT_CQ_SIZE=1048576
# export FI_CXI_DEFAULT_TX_SIZE=32768
export FI_CXI_RX_MATCH_MODE=hybrid    # Allow the network stack to transition to software mode if necessary.

# export NCCL_NET_GDR_LEVEL=3           # Typically improves performance, but remove this setting if you encounter a hang/crash.
# export NCCL_CROSS_NIC=0               # On large systems, this NCCL setting has been found to improve performance
export NCCL_SOCKET_IFNAME=hsn0        # NCCL/RCCL will use the high speed network to coordinate startup.
# export GLOO_SOCKET_IFNAME=hsn0

# This tells the GLOO backend to prepare for a huge number of incoming connections.
# It sets the listen() backlog to a high value.
# export GLOO_TCP_IFACE_LISTEN_BACKLOG=4096

# --- Robust Master Address Discovery ---
readarray -t arr < <(scontrol show hostnames $SLURM_NODELIST)
master_node=${arr[0]}
export MASTER_ADDR=$(ssh $master_node "ip -4 addr show ${HIGH_SPEED_INTERFACE} | grep 'inet' | awk '{print \$2}' | cut -d/ -f1 | head -n1")
if [[ -z "${MASTER_ADDR}" ]]; then
    echo "FATAL: Could not determine MASTER_ADDR for interface '${HIGH_SPEED_INTERFACE}' on master node '${master_node}'."
    exit 1
fi
export MASTER_PORT=29500

echo "--- Frontier Distributed Training Setup ---"
echo "MASTER_NODE: ${master_node}"
echo "MASTER_ADDR: ${MASTER_ADDR} (using interface: ${NCCL_SOCKET_IFNAME})"
echo "-----------------------------------------"


# --- Other Script Variables ---
current_time=$(date +%Y-%m-%d_%H-%M-%S)
# export OMP_NUM_THREADS=2
# export TRITON_PTXAS_NUM_WORKERS=4
export TRITON_PTXAS_NUM_WORKERS=1
export OMP_NUM_THREADS=1
export NCCL_TIMEOUT=1200
export NCCL_TIMEOUT_MS=1200000
export TORCH_NCCL_BLOCKING_WAIT=1

# help exit the program if nccl hang 
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export NCCL_ASYNC_ERROR_HANDLING=1

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# export NCCL_P2P_DISABLE=1
# ================================================== END of Frontier Global Env Var Setup Up =============================================================


# ================================================== Nodes Connection Check =============================================================
# --- Final srun Launch Command ---
gpus_per_node=$(( TOTAL_GPUS / NODES ))
LOG_FILE="logs/n${TOTAL_GPUS}-gbs${GLOBAL_BATCH_SIZE}-${MOE_TYPE}-${RUN_TYPE}.log"

echo "--- Running Environment Diagnostic ---"
echo "--- Script started at: $(date '+%F %T') ---"
srun -N ${NODES} -n ${TOTAL_GPUS} -c6 --ntasks-per-node=${gpus_per_node} --gpus-per-node=${gpus_per_node} \
    bash -c ' \
        if [[ $SLURM_PROCID -eq 0 ]]; then \
            echo "--- Environment on Rank 0 ---"; \
            env | grep -E "MASTER_ADDR|OMPI_MCA|NCCL_SOCKET_IFNAME|FI_"; \
            echo "-----------------------------"; \
        fi \
    '

echo "--- Cache warm done at: $(date '+%F %T') ---"

