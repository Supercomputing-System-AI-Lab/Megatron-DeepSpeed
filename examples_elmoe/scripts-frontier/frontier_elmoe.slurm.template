# ================================================== Launch ELMoE Training =============================================================
export to_profile="False"
export profile_memory="False"
# export to_profile="True"
# export profile_memory="True"


export profile_dir="${JOB_DIR}/torch_profile"

planner_mode="{{RUN_PLANNER}}"

# Validate planner mode — default to false if unrecognized
if [[ "$planner_mode" != "true" && "$planner_mode" != "true-membal" ]]; then
    planner_mode="false"
fi


echo "Before launching srun python python ../pretrain_gpt_deepspeed.py"
echo "--- Script started at: $(date '+%F %T') ---"

srun -N ${NODES} -n ${TOTAL_GPUS} -c6 \
     --ntasks-per-node=${gpus_per_node} \
     --gpus-per-node=${gpus_per_node} \
     --kill-on-bad-exit=1 \
     --export=ALL,FI_MR_CACHE_MONITOR,FI_CXI_DEFAULT_CQ_SIZE,FI_CXI_RX_MATCH_MODE,NCCL_DEBUG,UNEVEN_PP,TRITON_CACHE_DIR,TRITON_DISABLE_CACHE \
     bash -c "

     python ../ELMoE_launch.py \
        --run-planner ${planner_mode} \
        --planner-profile-dir ./planner_profiling_cache \
        ${megatron_options} \
        ${data_options} \
        ${deepspeed_options} \
        --master-addr=$MASTER_ADDR \
        --zero-stage {{ZERO}} \
        > ${JOB_DIR}/rank_\${SLURM_PROCID}.log"
# ================================================== END of Launch ELMoE Training =============================================================



# ================================================== Start Run Analysis =============================================================
echo "--- Starting Log Analysis ---"

# 1. Define Paths
LAST_RANK=$(( TOTAL_GPUS - 1 ))
# JOB_DIR="logs/job_${SLURM_JOB_ID}"
RANK_LOG_FILE="${JOB_DIR}/rank_${LAST_RANK}.log"
RANK_LOG_FILE_2="${JOB_DIR}/rank_0.log"
