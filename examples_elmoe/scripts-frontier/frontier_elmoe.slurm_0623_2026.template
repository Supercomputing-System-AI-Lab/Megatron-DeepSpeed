# ================================================== Monitor Runs ==================================
# Async pipeline-stall monitor (body lives in monitor_run.sh, same dir). Backgrounded so it never
# blocks the training srun. Writes into ${JOB_DIR}/monitor/ :
#   a-monitor.txt   — SUMMARY: per-interval state histogram across ALL ranks + frozen/odd counts +
#                     unsamplable ranks + culprit native stack (read this first; scales to 960 GPUs).
#   <hostname>.txt  — per-node detail (one row per rank: STATUS RANK GPU PID TRACE).
#   monitor.tsv     — one row per (interval,rank) for grep/plot.
# Needs ~/.local/bin/py-spy on $HOME (shared across nodes).
# Adaptive cadence: every 1 min for the first 5 min (catch first-iteration hangs), then every 3 min.
MON_FAST=120; MON_SLOW=240; MON_WINDOW=1200; MON_TRACE_FRAMES=20
bash "${DIR:-.}/monitor_run.sh" "${JOB_DIR}" "${MON_FAST}" "${MON_SLOW}" "${MON_WINDOW}" "${MON_TRACE_FRAMES}" &
MONITOR_PID=$!
trap 'kill ${MONITOR_PID} 2>/dev/null' EXIT
echo "[monitor] pid ${MONITOR_PID} -> ${JOB_DIR}/monitor/ (a-monitor.txt summary + per-node files; ${MON_FAST}s for first ${MON_WINDOW}s, then ${MON_SLOW}s)"
# ================================================== END of Monitor Runs ==================================


# ============================ TIMEOUT-SAFE ANALYSIS (ported from ELMoE branch) ============================
# Run the log analysis even when the job hits its SLURM walltime.
#   - Header `#SBATCH --signal=B:USR1@180` signals this batch shell 180s before the wall.
#   - The end-of-script analysis now lives in run_analysis() (guarded to run at most once).
#   - on_timeout() (SIGUSR1 handler) stops training so rank logs flush, then runs run_analysis.
#   - The training srun is backgrounded and `wait`ed by PID so this trap can interrupt it.
_ANALYSIS_DONE=0
run_analysis() {
    [ "${_ANALYSIS_DONE}" -eq 1 ] && return 0     # run at most once (timeout OR normal completion)
    _ANALYSIS_DONE=1
echo "--- Starting Log Analysis ---"

# 1. Define Paths
LAST_RANK=$(( TOTAL_GPUS - 1 ))
# JOB_DIR="logs/job_${SLURM_JOB_ID}"
RANK_LOG_FILE="${JOB_DIR}/rank_${LAST_RANK}.log"
RANK_LOG_FILE_2="${JOB_DIR}/rank_0.log"
# SLURM_LOG_FILE="logs/xmoe-${RUN_TYPE}-${SLURM_JOB_ID}.o"
SLURM_LOG_FILE="${JOB_DIR}/a-xmoe-${RUN_TYPE}-${SLURM_JOB_ID}.o"

# 2. Define the Merged Log Path (Keeping it permanent)
MERGED_LOG="${JOB_DIR}/full_run.log"

# 3. Wait a moment for file system sync
sleep 5

# 4. Create the Merged Log
#    First: Put the SLURM output (Config, Memory Stats, Env Vars)
if [ -f "${SLURM_LOG_FILE}" ]; then
    cat "${SLURM_LOG_FILE}" > "${MERGED_LOG}"
else
    echo "Warning: SLURM .o file not found at ${SLURM_LOG_FILE}" > "${MERGED_LOG}"
fi

#    Separator
echo -e "\n\n==========================================================\n" >> "${MERGED_LOG}"
echo -e "--- RANK ${LAST_RANK} METRICS (LOSS/TFLOPS) BELOW ---\n" >> "${MERGED_LOG}"
echo -e "==========================================================\n" >> "${MERGED_LOG}"

#    Second: Append the Rank Log (Loss, TFLOPS, Timers)
if [ -f "${RANK_LOG_FILE_2}" ]; then
    cat "${RANK_LOG_FILE_2}" >> "${MERGED_LOG}"
else
    echo "Error: Rank log file not found at ${RANK_LOG_FILE_2}" >> "${MERGED_LOG}"
fi
if [ -f "${RANK_LOG_FILE}" ]; then
    cat "${RANK_LOG_FILE}" >> "${MERGED_LOG}"
else
    echo "Error: Rank log file not found at ${RANK_LOG_FILE}" >> "${MERGED_LOG}"
fi

echo "Merged log saved to: ${MERGED_LOG}"

# 5. Run Analysis on the MERGED file
#    The script will now find "Peak Memory" (from top) and "lm loss" (from bottom)
python ../utils/analyze_log.py \
        "${MERGED_LOG}" \
        --iterations $TRAIN_ITERS \
        --nodes $NODES \
        --gpus_per_node $gpus_per_node \
        --pp $PP_SIZE \
        --ep $EP_PARALLEL_SIZE \
        --dp $(( TOTAL_GPUS / PP_SIZE / MP_SIZE )) \
        --tp $MP_SIZE \
        --gbs $GLOBAL_BATCH_SIZE \
        --mbs $BATCH_SIZE \
        --slurm_job_id $SLURM_JOB_ID \
        --seqlen $SEQ_LEN \
        --num_layers $NUM_LAYERS \
        --num_experts $EP_SIZE \
        --expert_dim $FFN_HIDDEN_SIZE \
        --topk $topk \
        --hidden_dim $HIDDEN_SIZE \
        --moe_type $MOE_TYPE \
        --model_size $MODEL_SIZE \
        --activation_checkpointing $ACTIVATION_CHECKPOINT \
        --checkpoint_interval $CHECKPOINT_NUM_LAYERS \
        --dynamic_checkpoint $DYNAMIC_CHECKPOINT \
        --uneven_pp $UNEVEN_PP \
        --zero $ZERO_STAGE ${ANALYZE_LOG_PROFILING_FLAG} >> "${MERGED_LOG}"

python ../utils/analyze_memory.py "${MERGED_LOG}" #>> "${MERGED_LOG}"

echo "Analysis Complete. Full log: ${MERGED_LOG}"
}
# SIGUSR1 handler: ~180s before walltime, stop the training step so rank_*.log flush, then analyze.
on_timeout() {
    echo "[timeout-guard] SIGUSR1 received ~180s before walltime — stopping training, analyzing early."
    if [ -n "${TRAIN_PID:-}" ]; then
        kill -TERM "${TRAIN_PID}" 2>/dev/null || true
        sleep 10                                  # give ranks a moment to flush rank_*.log
        wait "${TRAIN_PID}" 2>/dev/null || true
    fi
    run_analysis
    exit 0                                        # the monitor's EXIT trap still runs on exit
}
# Separate trap so it does NOT clobber the monitor's `trap ... EXIT`.
trap on_timeout USR1
# ============================ END TIMEOUT-SAFE ANALYSIS ============================


