# -----------------------------------------------------------

# ----- SFT (answer-only loss). Launch: -----------------------------------
#   SFT_MODE=1 SFT_DATA_PATH=<prefix>_text_document ./local_autorun_...
# with LOAD_CHECKPOINT_PATH pointed at the STEP-0 IMPORTED BASE above and
# the dispatcher iters set to ~2 epochs (docs_kept x 4096 x 2 / GBS/seq).
# Nothing here runs unless SFT_MODE=1 -- the mid-training path is untouched.
if [ "${SFT_MODE:-0}" == "1" ] || [ "${SFT_MODE:-0}" == "full" ]; then
    LR=1e-5                       # DeepSeekMoE-Chat's own SFT recipe;
    MIN_LR=1e-6                   # the pretraining LR above would wreck the base
    if [ "${SFT_MODE}" == "1" ]; then
        # Masked SFT on the PADDED two-stream corpus (dolci-sft-deepseek).
        # docs_kept=1,909,572 (manifest 2026-08-13); 2 epochs ~852 iters at GBS 4480.
        TRAIN_TOKENS=15643213824      # 1,909,572 x 4096 x 2
        WARMUP_TOKENS=1835008000      # ~100 steps x 4480 x 4096
        LR_DECAY_TOKENS=13808205824   # TRAIN - WARMUP
    else
        # SFT_MODE=full: full-loss ablation on the UNPADDED corpus
        # (dolci-fullloss-deepseek, built with --no-pad). Same rows, same LR,
        # no mask -- 2 epochs = 2 x 1,198,536,345 real tokens, ~131 iters.
        TRAIN_TOKENS=2397072690
        WARMUP_TOKENS=256901120       # ~14 steps
        LR_DECAY_TOKENS=2140171570
    fi
    # optional override for short/1-node diagnostic runs (e.g. the overfit
    # gate): the token-based warmup is sized for GBS 4480 and would pin LR
    # at ~0 for thousands of iters at a small GBS.
    WARMUP_TOKENS="${SFT_WARMUP_TOKENS:-$WARMUP_TOKENS}"
    export DATA_PATH="${SFT_DATA_PATH:?SFT_MODE needs SFT_DATA_PATH (a _text_document prefix)}"
fi
# --------------------------------------------------------------------------

# ----- Long-context extension (LC_MODE=1): 4096 -> 8192 raw-text CPT -------
# Launch: LC_MODE=1 ./local_autorun_...  with the dispatcher NBS HALVED
# (70 -> 35) so token-GBS stays 18.35M/step at the doubled seq length.
# Turn 1 loads the mid-training checkpoint with the manual --finetune toggle
# ON (fresh schedule + skips the seq-length checkpoint-args check);
# continuation turns: toggle OFF, as always. Full loss, no mask.
if [ "${LC_MODE:-0}" == "1" ]; then
    # SEQ_LEN="${LC_SEQ_LEN:-8192}"
    LR=${LC_LR:-4.2e-5}              # late-pretraining-scale LR for the extension; LC_LR overrides (2026-10-06: the DeepSeek-V3 paper's 7.3e-6 for the 671B), default unchanged
    MIN_LR=${LC_MIN_LR:-${LC_LR:-4.2e-5}}
    TRAIN_TOKENS="${LC_TRAIN_TOKENS:-11000000000}"    # 34% long + 66% short replay
    WARMUP_TOKENS=0
    LR_DECAY_TOKENS="${LC_DECAY_TOKENS:-4450000000}"
    LC_LONG="${LC_LONG_PREFIX:-/lustre/orion/gen150/scratch/zixianw4/X-MoE/Megatron-DeepSpeed-X-MoE/examples_elmoe/data/longctx/L8-dolma3-deepseek_text_document}"
    LC_REPLAY="${LC_REPLAY_PREFIX:-/lustre/orion/gen150/scratch/zixianw4/X-MoE/Megatron-DeepSpeed-X-MoE/examples_elmoe/data/nemotron/nemotron-deepseek_text_document}"
    # LC_DATA_PATH overrides the whole blend (e.g. the 9-stream mix16k list);
    # default = the original 34/66 two-stream blend, unchanged.
    export DATA_PATH="${LC_DATA_PATH:-0.34 ${LC_LONG} 0.66 ${LC_REPLAY}}"
fi
