# ================================================== Megatron Setup =============================================================
# [2026-09-20 11:40, the user] the Ulysses degree divides the batch: the P ranks of a sequence-parallel group form ONE data-parallel
# replica (Megatron: data_parallel_size = world / (PP x TP x P), as upstream's world / (TP x PP x CP)), so NUM_BATCHES means micro-batches
# per replica per step. DS_SEQ_PAR_SIZE is 1 unless the AUTORUN_DS_SEQUENCE_PARALLEL_SIZE rider sets it, which keeps every run without
# Ulysses byte-identical in arithmetic; the runs of 2026-09-17..20 with Ulysses P trained P x NUM_BATCHES x DP_NON_MOE sequences per step.
DS_SEQ_PAR_SIZE=${DS_SEQ_PAR_SIZE:-1}
GLOBAL_BATCH_SIZE=$(( NUM_BATCHES * BATCH_SIZE * (TOTAL_GPUS / PP_SIZE / MP_SIZE / DS_SEQ_PAR_SIZE) ))
echo "GLOBAL_BATCH_SIZE=$GLOBAL_BATCH_SIZE"

# --- Resolved parallel layout (informational) --------------------------------
# A MoE model has TWO INDEPENDENT data-parallel widths:
#     DP_NON_MOE = TOTAL_GPUS / PP / TP     non-expert grads all-reduce over this
#     DP_MOE     = TOTAL_GPUS / PP / EP     expert grads all-reduce over this
# TP does NOT divide DP_MOE: with enable_expert_tensor_parallelism=False (X-MoE's default)
# deepspeed/moe/layer.py takes the _create_expert_and_data_parallel branch, which carves expert
# groups from the GLOBAL rank space and only asserts _ensure_divisibility(TOTAL_GPUS/PP, EP).
# EP*TP is therefore allowed to exceed TOTAL_GPUS (e.g. 8 GPUs with EP8+TP4 -> DP_moe=1,
# DP_non_moe=2). GLOBAL_BATCH_SIZE above depends on DP_NON_MOE only, so EP never changes the
# batch math. NOTE: EP_SIZE here is the model's NUMBER OF EXPERTS from model_registry.py,
# not a parallel degree; TED-MOE (--enable-expert-tensor-parallelism) uses a different branch
# where EP must instead divide DP_NON_MOE.
PP_STRIDE=$(( TOTAL_GPUS / PP_SIZE ))
DP_NON_MOE=$(( PP_STRIDE / MP_SIZE / DS_SEQ_PAR_SIZE ))   # [2026-09-20] the Ulysses group is one replica
if (( EP_PARALLEL_SIZE >= 1 && PP_STRIDE % EP_PARALLEL_SIZE == 0 )); then
    DP_MOE=$(( PP_STRIDE / EP_PARALLEL_SIZE ))
else
    DP_MOE="INVALID"
    echo "WARNING: EP=${EP_PARALLEL_SIZE} does not divide TOTAL_GPUS/PP=${PP_STRIDE}; DeepSpeed's"
    echo "         _ensure_divisibility(pp_stride, ep_size) will abort this run."
fi
echo "DP_NON_MOE (attention/dense DP width) : $DP_NON_MOE   (= ${TOTAL_GPUS} / PP ${PP_SIZE} / TP ${MP_SIZE} / Ulysses ${DS_SEQ_PAR_SIZE})"
echo "DP_MOE     (replicas per expert shard): $DP_MOE   (= ${TOTAL_GPUS} / PP ${PP_SIZE} / EP ${EP_PARALLEL_SIZE})"
if (( EP_PARALLEL_SIZE >= 1 && EP_SIZE % EP_PARALLEL_SIZE == 0 )); then
    echo "LOCAL_EXPERTS (experts per rank): $(( EP_SIZE / EP_PARALLEL_SIZE ))  (num_experts=${EP_SIZE} / EP=${EP_PARALLEL_SIZE})"
else
    echo "WARNING: num_experts=${EP_SIZE} is not divisible by EP=${EP_PARALLEL_SIZE}; deepspeed/moe/layer.py will assert."
fi

# --- Static Training Parameters ---
# 200M tokens for LR tuning 
