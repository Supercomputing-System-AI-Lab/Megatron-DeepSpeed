# ================================================== Universal Checkpoint Conversion =============================================================
# Converts the DeepSpeed checkpoint under $LOAD_CHECKPOINT_PATH into Universal Checkpoint format so
# training can resume under a different TP/PP/DP/EP. Runs automatically when BOTH hold:
#   * megatron_options contains --universal-checkpoint
#   * LOAD_CHECKPOINT_PATH points at a directory containing a DeepSpeed `latest` tag file
#
# IDEMPOTENT: if <parent>/<tag>_universal already looks complete it is reused, so re-submitting the
# same job does not reconvert ~183 GiB. Export UCP_FORCE=1 to reconvert anyway.
#
# WALLTIME: conversion reads ~183 GiB and writes ~183 GiB of fragments, then merges those into
# ~183 GiB of atoms. Budget 20-40 min ON TOP of training time, or convert once with
# convert_to_universal.slurm and let subsequent jobs hit the "reusing existing" path.
#
# Tunables (export before sbatch):
#   UCP_WORKERS_EXTRACT   default 4. Each worker holds ONE whole ZeRO shard (~23 GiB for DeepSeek_16B),
#                         so this is the knob that controls peak RAM. There are only DP shards to do,
#                         and ds_to_universal clamps the count for you.
#   UCP_WORKERS_MERGE     default 4. Each worker holds whole parameters; the largest is the embedding.
#   UCP_FORCE=1           reconvert even if the output already exists.
#
# NOTE: deliberately no `set -euo pipefail` here -- it would change the behaviour of the whole
# template. Every step below is checked explicitly instead.
convert_to_universal() {
    local parent="$1"
    local workers_extract="${UCP_WORKERS_EXTRACT:-4}"
    local workers_merge="${UCP_WORKERS_MERGE:-4}"
    local tag step_dir out_dir rc n_atoms n_expert

    echo "================ Universal Checkpoint conversion ================"

    if [[ -z "${parent}" || ! -d "${parent}" ]]; then
        echo "FATAL: --universal-checkpoint is set but LOAD_CHECKPOINT_PATH='${parent}' is not a directory (cwd=$(pwd))"
        return 1
    fi

    # DeepSpeed records the newest tag in <parent>/latest, e.g. "global_step60".
    tag=$(cat "${parent}/latest" 2>/dev/null)
    if [[ -z "${tag}" ]]; then
        echo "FATAL: '${parent}/latest' is missing or empty -- not a DeepSpeed checkpoint directory."
        echo "       (A weights-only import such as deepseek_16b_ds has no optimizer state and cannot"
        echo "        be converted; load it with --finetune and WITHOUT --universal-checkpoint.)"
        return 1
    fi

    step_dir="${parent}/${tag}"
    out_dir="${parent}/${tag}_universal"

    echo "  latest DeepSpeed step : ${tag}"

    # Is the LATEST step already converted? Three conditions, all required:
    #   1. zero/optimizer_state.pt exists      -- the merge phase ran to completion
    #   2. no tmp/ left behind                 -- extraction was not interrupted
    #   3. at least one atom directory         -- guards against an empty zero/ from a killed job
    # Anything less and we reconvert rather than resume from a partially populated zero/.
    local n_existing=0
    if [[ -d "${out_dir}/zero" ]]; then
        n_existing=$(find "${out_dir}/zero" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    fi
    if [[ -f "${out_dir}/zero/optimizer_state.pt" && ! -d "${out_dir}/tmp" && ${n_existing} -gt 0 ]]; then
        if [[ -n "${UCP_FORCE:-}" ]]; then
            echo "  universal checkpoint for ${tag} exists (${n_existing} atoms) but UCP_FORCE=1 -- reconverting"
        else
            echo "  ALREADY CONVERTED: ${out_dir}  (${n_existing} atoms) -- skipping conversion"
            echo "  (export UCP_FORCE=1 to reconvert)"
            printf '%s\n' "${tag}_universal" > "${parent}/latest_universal"
            echo "  latest_universal -> ${tag}_universal"
            echo "================================================================"
            return 0
        fi
    elif [[ -d "${out_dir}" ]]; then
        echo "  found an INCOMPLETE ${out_dir} (atoms=${n_existing},"
        echo "        optimizer_state.pt=$([ -f "${out_dir}/zero/optimizer_state.pt" ] && echo yes || echo no),"
        echo "        tmp/=$([ -d "${out_dir}/tmp" ] && echo present || echo absent)) -- reconverting"
    else
        echo "  no universal checkpoint for ${tag} yet -- converting"
    fi

    echo "  input   : ${step_dir}"
    echo "  output  : ${out_dir}"
    echo "  workers : extract=${workers_extract} merge=${workers_merge}"
    echo "  started : $(date '+%F %T')"
    if [[ ! -d "${step_dir}" ]]; then
        echo "FATAL: ${step_dir} does not exist (referenced by ${parent}/latest)"
        return 1
    fi
    df -h . | tail -1

    mkdir -p "${out_dir}"
    # Atom files are large and written sequentially: stripe so the merge phase is not served by one OST.
    lfs setstripe -c 8 -S 4M "${out_dir}" 2>/dev/null || echo "  (lfs setstripe unavailable; continuing)"

    srun -N1 -n1 -c 32 env LD_PRELOAD="${DARSHAN_PRELOAD}" python -m deepspeed.checkpoint.ds_to_universal \
        --input_folder  "${step_dir}" \
        --output_folder "${out_dir}" \
        --num_extract_workers "${workers_extract}" \
        --num_merge_workers   "${workers_merge}"
    rc=$?
    if [[ ${rc} -ne 0 ]]; then
        echo "FATAL: ds_to_universal exited ${rc}."
        return ${rc}
    fi

    n_atoms=$(find "${out_dir}/zero" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    n_expert=$(find "${out_dir}/zero" -mindepth 1 -maxdepth 1 -type d -name '*deepspeed_experts*' 2>/dev/null | wc -l)
    echo "  finished: $(date '+%F %T')"
    echo "  atoms total       : ${n_atoms}"
    echo "  expert atoms      : ${n_expert}  (expect num_moe_layers * num_experts * 2)"
    echo "  optimizer_state.pt: $([ -f "${out_dir}/zero/optimizer_state.pt" ] && echo present || echo MISSING)"
    echo "  latest_universal  -> $(cat "${parent}/latest_universal" 2>/dev/null || echo MISSING)"

    # A surviving tmp/ means the merge phase did not run to completion; resuming from a partially
    # populated zero/ would die on the first missing atom, so stop here instead.
    if [[ ! -f "${out_dir}/zero/optimizer_state.pt" || -d "${out_dir}/tmp" ]]; then
        echo "FATAL: conversion did not complete cleanly (tmp/ still present or optimizer_state.pt missing)."
        return 1
    fi
    echo "================================================================"
    return 0
}

if [[ "${megatron_options}" == *"--universal-checkpoint"* && "${UCP_SKIP_CONVERT:-0}" != "1" ]]; then
    # UCP_SKIP_CONVERT=1 -> trust the existing universal dir as-is. Needed when the
    # atoms were prepared externally (e.g. migrate_ucp_namespace.py renamed a legacy
    # GPTModel-namespace conversion for a pipe-class resume) -- this block would
    # otherwise regenerate/restore the original namespace over the migration.
    if ! convert_to_universal "${LOAD_CHECKPOINT_PATH:-}"; then
        echo "Aborting job: universal checkpoint conversion failed. Training would resume from an"
        echo "incomplete checkpoint, so nothing is launched."
        exit 1
    fi
else
    echo "[universal-checkpoint] --universal-checkpoint not set; skipping conversion."
fi
