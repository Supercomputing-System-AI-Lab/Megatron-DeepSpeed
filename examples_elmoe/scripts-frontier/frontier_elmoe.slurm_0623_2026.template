# ================================================== Darshan Profiling Variables =============================================================
# Darshan 3.4.7 (Lustre-enabled gcc-14.2 build; the help-desk's cce-20.0.0 path does not exist on
# the system) in NONMPI mode, because the training ranks are plain Python processes.
#
# SCOPE (2026-09-05): the preload is applied PER PROCESS, on the python command inside the srun
# below and on the converter's python, never exported job-wide. Job-wide export instrumented every
# bash/mkdir/as/ls of the job and wrote up to ~1M two-KB logs per day into the central directory
# (974,551 on 2026-08-30). Darshan's APP_INCLUDE directive and the DARSHAN_APP_INCLUDE variable
# were both tested on the login node and are NOT honoured by this build, so scoping by where the
# preload is set is the only mechanism that works.
#
# LOGS (2026-09-05): DARSHAN_LOGPATH is honoured once <path>/<Y>/<M>/<D> exists (verified on the
# login node), so every run keeps its own logs under ${JOB_DIR}/darshan/ instead of the central
# /lustre/orion/darshan/frontier tree; today's and tomorrow's date directories are created so a job
# that crosses midnight still lands. No DARSHAN_LOGFILE: with NONMPI every process writes a log and
# a fixed name would clobber (the auto name is unique per process).
source /usr/share/lmod/lmod/init/bash 2>/dev/null || true
module unload darshan-runtime 2>/dev/null || true
DARSHAN_PRELOAD="/opt/cray/libfabric/2.3.1/lib64/libfabric.so /sw/frontier/spack-envs/cpe26.03-cpu/opt/__spack_path_placeholder__/__spack_path_placeholder__/__spack_path_placeholder__/__spac/gcc-14.2/darshan-runtime-3.4.7-i6lglufb3nzhpr6gneuq2bjdaonwtv66/lib/libdarshan.so"
export DARSHAN_ENABLE_NONMPI=1          # REQUIRED for Python (no MPI-link interposition)
export DARSHAN_MOD_ENABLE="POSIX,STDIO,MPI-IO,LUSTRE,DXT_POSIX"  # LUSTRE now produces data (enable-lustre build)
export DARSHAN_CONFIG_PATH="${PWD}/darshan.conf"   # absolute: ./ is unreliable on compute-node CWD
export DARSHAN_LOGPATH="${PWD}/${JOB_DIR}/darshan"
mkdir -p "${DARSHAN_LOGPATH}/$(date +%Y/%-m/%-d)" "${DARSHAN_LOGPATH}/$(date -d tomorrow +%Y/%-m/%-d)"

