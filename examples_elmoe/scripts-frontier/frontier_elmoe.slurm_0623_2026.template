# TORCH_NCCL_ASYNC_ERROR_HANDLING=1 leaves ONLY the blocking wait in force (PyTorch keeps one of the two), and the blocking wait
# does not cover a stream sync after a collective: with one rank stopped, the other 15 waited 31 min in .tolist() after the expert
# all-to-all with no error (5639309); the 256-node link 5638129 waited 86 min the same way. With the blocking wait OFF the watchdog
# thread fires at the group timeout (10 min on the expert group), names the collective and tears the processes down (5639642:
# "Watchdog caught collective operation timeout: WorkNCCL(SeqNum=2497, OpType=ALLTOALL_BASE ...)"). The flight recorder writes the
# last collectives of every rank into the job folder on that timeout, so the rank that never entered the collective is readable.
export TORCH_NCCL_BLOCKING_WAIT=0
export NCCL_BLOCKING_WAIT=0
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export NCCL_ASYNC_ERROR_HANDLING=1
export TORCH_NCCL_DUMP_ON_TIMEOUT=1
export TORCH_NCCL_TRACE_BUFFER_SIZE=2000
export TORCH_NCCL_DEBUG_INFO_TEMP_FILE="${JOB_DIR}/nccl_trace_rank_"

