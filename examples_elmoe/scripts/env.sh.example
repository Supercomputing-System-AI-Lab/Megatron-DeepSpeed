#!/bin/bash
###############################################################################
# env.sh.example — site-specific environment for the non-SLURM (torchrun) path.
#
#   cp env.sh.example env.sh    and edit for your machine.
#
# WHY THIS FILE EXISTS
#   For MULTI-NODE runs the launcher ssh's to each host, and **ssh does not carry
#   your environment**: no conda env, no `module load`, no RCCL/network exports.
#   elmoe.sh.template sources this file on EVERY node before starting torchrun, so
#   whatever a rank needs to run must be set here (not just in your login shell).
#
#   For single-node runs it is sourced too, so one file covers both.
#
# WHAT MUST BE IN HERE
#   1. Your Python environment (conda activate / venv / module load).
#   2. Any accelerator + network settings for your interconnect.
#   3. NOTHING per-rank: never set RANK, LOCAL_RANK, WORLD_SIZE, SLURM_PROCID or
#      SLURM_LOCALID here. torchrun sets the first three per worker, and exporting
#      SLURM_PROCID would make every rank think it has the same rank
#      (pretrain_gpt_deepspeed.py reads SLURM_PROCID before RANK).
###############################################################################

# --- 1. Python environment -------------------------------------------------
# module load rocm/6.4.1                      # if your site uses modules
# source "$(conda info --base)/etc/profile.d/conda.sh"
# conda activate /path/to/your/ELMoE-env
#
# CUDA sites: `conda activate` alone is enough. setup_env_cuda.sh installs an
# activation hook (etc/conda/activate.d/zzz-elmoe-cuda.sh) that exports CUDA_HOME
# and CPATH, both of which Megatron's JIT fused-kernel build needs — torch's
# cpp_extension adds only "$CUDA_HOME/include" and ignores conda's CFLAGS, so
# without them the first training step dies with:
#     fatal error: cuda_fp16.h: No such file or directory
# For an env built BEFORE that hook existed, run once:
#     ./setup_env_cuda.sh envhook
# or, if you cannot modify the env, uncomment this fallback:
# export CPATH="$CONDA_PREFIX/targets/x86_64-linux/include${CPATH:+:$CPATH}"

# --- 2. Accelerator ---------------------------------------------------------
# export HIP_VISIBLE_DEVICES=0,1,2,3,4,5,6,7  # AMD
# export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7 # NVIDIA
# (Leave unset to let torchrun use all local GPUs.)

# --- 3. Network / collectives ----------------------------------------------
# Pick the interface RCCL/NCCL should use for coordination:
# export NCCL_SOCKET_IFNAME=eth0

# --- AMD / Slingshot (Frontier-like) ---------------------------------------
# export NCCL_SOCKET_IFNAME=hsn0
# export FI_MR_CACHE_MONITOR=kdreg2
# export FI_CXI_DEFAULT_CQ_SIZE=524288
# export FI_CXI_DEFAULT_TX_SIZE=16384
# export FI_CXI_RX_MATCH_MODE=hybrid
# AWS-OFI-RCCL plugin (built by setup_env_rocm.sh aws-ofi-rccl):
# export NCCL_NET_PLUGIN=$HOME/ELMoE_deps/aws-ofi-rccl/lib/librccl-net.so
# export LD_LIBRARY_PATH=$HOME/ELMoE_deps/aws-ofi-rccl/lib:$LD_LIBRARY_PATH

# --- NVIDIA / InfiniBand ----------------------------------------------------
# export NCCL_IB_DISABLE=0
# export NCCL_NET_GDR_LEVEL=3

# --- 4. Optional ------------------------------------------------------------
# export PYTHONPATH=/path/to/X-MoE:/path/to/X-MoE/primus_turbo:$PYTHONPATH
# export NCCL_DEBUG=WARN                     # template sets INFO; override here
