#!/bin/bash
###############################################################################
# xmoe_4d.sh.template — non-SLURM (torchrun) counterpart of
#                     scripts-frontier/frontier_xmoe_4d.slurm.template
#
# Rendered by autorun.sh / run_exp_training.sh (same placeholder sed-fill),
# then executed with `bash` instead of submitted with `sbatch`.
#
# PORTING NOTES (differences from the SLURM template — everything else is verbatim):
#   1. No #SBATCH header, and no SIGUSR1 timeout guard: there is no wall clock
#      off-scheduler, so run_analysis() is simply called at the end.
#   2. JOB_ID replaces $SLURM_JOB_ID. It MUST be all digits — utils/analyze_memory.py
#      matches `job_(\d+)` and then globs `*<job_id>.o`, and utils/rerun_analysis.sh
#      greps `job_[0-9]+`. A non-numeric id silently breaks the memory analysis.
#   3. We EXPORT SLURM_NTASKS / SLURM_NNODES. ELM_PP_launch.py reads its planner
#      topology from them; torchrun does not set them. This is why NO shared file
#      needed modifying (see also #4).
#   4. We must NEVER export SLURM_PROCID / SLURM_LOCALID. pretrain_gpt_deepspeed.py
#      reads SLURM_PROCID *before* RANK; a single exported value would make every
#      rank believe it has the same rank. The SLURM template's
#      `export RANK/WORLD_SIZE/LOCAL_RANK` block is therefore NOT ported —
#      torchrun sets RANK / LOCAL_RANK / WORLD_SIZE itself.
#   5. srun -> torchrun, and `--using-torchrun` is added to megatron_options so
#      Megatron reads rank/world from env instead of importing mpi4py.
#   6. The driver's stdout is tee'd by autorun.sh into
#      ${JOB_DIR}/a-xmoe-${RUN_TYPE}-${JOB_ID}.o so that run_analysis(),
#      analyze_memory.py and rerun_analysis.sh keep working UNCHANGED.
#   7. monitor_run.sh is NOT started (its host enumeration is scontrol-bound).
#   8. Site-specific network/env settings live in env.sh (see env.sh.example),
#      sourced on every node — this template stays portable.
###############################################################################

# --- 1. Job identity (SLURM header replacement) ---
# autorun.sh exports JOB_ID (all digits). Fall back for standalone execution.
JOB_ID="${JOB_ID:-$(date +%s)}"

# --- 2. Templatized Variable Definitions ---
BATCH_SIZE={{BATCH_SIZE}}
NUM_BATCHES={{NUM_BATCHES}}
PP_SIZE={{PP_SIZE}}
EP_PARALLEL_SIZE={{EP_PARALLEL_SIZE}}
MP_SIZE={{MP_SIZE}}
NODES={{NODES}}
TOTAL_GPUS={{TOTAL_GPUS}}
TRAIN_ITERS={{TRAIN_ITERS}}
MOE_TYPE="{{MOE_TYPE}}"
MODEL_SIZE="{{MODEL_SIZE}}"
RUN_TYPE="{{RUN_TYPE}}"
ACTIVATION_CHECKPOINT="{{ACTIVATION_CHECKPOINT}}"
CHECKPOINT_NUM_LAYERS="{{CHECKPOINT_NUM_LAYERS}}"
DYNAMIC_CHECKPOINT="{{DYNAMIC_CHECKPOINT}}"
UNEVEN_PP="{{UNEVEN_PP}}"
RUN_PLANNER="{{RUN_PLANNER}}"
COLLECT_PROFILING_CACHE="{{COLLECT_PROFILING_CACHE}}"
ZERO_STAGE={{ZERO}}

# Site config (see env.sh.example). HOSTFILE is only consulted when NODES > 1.
XMOE4D_ENV_FILE="${XMOE4D_ENV_FILE:-$PWD/env.sh}"
HOSTFILE="${HOSTFILE:-$PWD/hostfile}"
MASTER_PORT="${MASTER_PORT:-29500}"

# Source it in the DRIVER too, not just in node_launch.sh on each node.
#
# WHY: the driver shell itself runs python and py-spy — run_analysis() calls
# ../utils/analyze_*.py, and the monitor block probes for py-spy. Under SLURM the
# driver inherited a module-loaded environment so this never came up; off-scheduler,
# `bash autorun.sh` from a fresh shell leaves the driver with no conda env. The ranks
# still train correctly (node_launch.sh sources this file), so the run "succeeds"
# while the monitor silently skips and the analysis dies with:
#     line NNN: python: command not found
# Sourcing here is idempotent — conda activate on an already-active prefix just
# re-runs its activate.d hooks — and node_launch.sh still sources it per node, which
# is what matters for ssh'd hosts that share none of this shell's environment.
if [ -f "${XMOE4D_ENV_FILE}" ]; then
    echo "[driver] sourcing ${XMOE4D_ENV_FILE}"
    source "${XMOE4D_ENV_FILE}"
else
    echo "[driver] WARNING: no ${XMOE4D_ENV_FILE} — driver-side python/py-spy may be missing." >&2
    echo "[driver]          Copy env.sh.example to env.sh. Required for multi-node." >&2
fi

# Planner memory reserve, in BINARY GiB. The planner sets its budget to
#   (detected total GPU memory) - PLANNER_MEMORY_HEADROOM_GB
# so it adapts to whatever GPU this runs on. The reserve covers what the analytic
# memory model does NOT account for: the HIP/CUDA context, RCCL buffers,
# hipBLASLt/Triton scratch, and caching-allocator block rounding.
#
# 3.5 GiB (vs 2.5 on Frontier) — deliberately more conservative here, because this
# path targets UNKNOWN hardware where allocator behaviour has not been calibrated.
# Lower it once you have validated predicted-vs-actual memory on your machine
# (analyze_memory.py prints that table after every run).
PLANNER_MEMORY_HEADROOM_GB="${PLANNER_MEMORY_HEADROOM_GB:-1.5}"

echo "MICRO_BATCH_SIZE: $BATCH_SIZE"
echo "NUM_BATCHES: $NUM_BATCHES"
echo "PP_SIZE: $PP_SIZE"
echo "EP_SIZE: $EP_PARALLEL_SIZE"
echo "MP_SIZE: $MP_SIZE"
echo "NODES: $NODES"
echo "TOTAL_GPUS: $TOTAL_GPUS"
echo "TRAIN_ITERS: $TRAIN_ITERS"
echo "MOE_TYPE: $MOE_TYPE"
echo "RUN_TYPE: $RUN_TYPE"
echo "ACTIVATION_CHECKPOINT: $ACTIVATION_CHECKPOINT"
echo "CHECKPOINT_NUM_LAYERS: $CHECKPOINT_NUM_LAYERS"
echo "DYNAMIC_CHECKPOINT: $DYNAMIC_CHECKPOINT"
echo "UNEVEN_PP: $UNEVEN_PP"
echo "RUN_PLANNER: $RUN_PLANNER"
echo "COLLECT_PROFILING_CACHE: $COLLECT_PROFILING_CACHE"
echo "JOB_ID: $JOB_ID"

# --- Profiling-cache-collection overrides (identical to the SLURM template) ---
if [[ "$COLLECT_PROFILING_CACHE" == "true" ]]; then
    RUN_PLANNER="false"
    PROFILING_SKIP_CACHE_WARM=1
    ANALYZE_LOG_PROFILING_FLAG="--profiling"
else
    PROFILING_SKIP_CACHE_WARM=0
    ANALYZE_LOG_PROFILING_FLAG=""
fi

which python

JOB_DIR="logs/job_${JOB_ID}_pp{{PP_SIZE}}_ep{{EP_PARALLEL_SIZE}}_{{MOE_TYPE}}_ckpt_{{ACTIVATION_CHECKPOINT}}_planner_{{RUN_PLANNER}}"
mkdir -p "${JOB_DIR}"
echo "JOB_DIR: ${JOB_DIR}"

export DYNAMIC_CHECKPOINT=$DYNAMIC_CHECKPOINT
export UNEVEN_PP=$UNEVEN_PP

# ================================================== Model & Data Setup =============================================================
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TORCH_EXTENSIONS_DIR=$PWD/deepspeed
export HF_HOME=$PWD/hfdata
export OMP_NUM_THREADS=1

export CHECKPOINT_PATH=checkpoint/$(date +%Y-%m-%d)_${JOB_ID}_forge_small_dsv2_0.1_warmup
export VOCAB_FILE=../data/gpt2-vocab.json
export MERGE_FILE=../data/gpt2-merges.txt
export DATA_PATH=../data/my-gpt2_text_document

DIR=`pwd`
mkdir -p logs

# Get model config
CONFIG_VARS=$(python3 ../utils/model_registry.py get_vars --model_size "${MODEL_SIZE}")
if [ $? -ne 0 ]; then
    echo "Error: Model size '${MODEL_SIZE}' not found in registry."
    exit 1
fi
eval "$CONFIG_VARS"

echo "Model Config Loaded for ${MODEL_SIZE}:"
echo "  HIDDEN_SIZE: $HIDDEN_SIZE"
echo "  FFN_HIDDEN_SIZE:    $FFN_HIDDEN_SIZE"
echo "  NUM_LAYERS: $NUM_LAYERS"
echo "  NUM_ATTN_HEADS: $NUM_ATTN_HEADS"
echo "  EP_SIZE: $EP_SIZE"
echo "  topk: $topk"
echo "  SEQ_LEN: $SEQ_LEN"
echo "  KV_HEADS: $KV_HEADS"
# ================================================== END of Model & Data Setup =============================================================


# ================================================== Megatron Setup =============================================================
GLOBAL_BATCH_SIZE=$(( NUM_BATCHES * BATCH_SIZE * (TOTAL_GPUS / PP_SIZE / MP_SIZE) ))
echo "GLOBAL_BATCH_SIZE=$GLOBAL_BATCH_SIZE"

LR=4.2e-4
MIN_LR=4.2e-5
TRAIN_TOKENS=10000000000
WARMUP_TOKENS=1000000000
LR_DECAY_TOKENS=9000000000
EXIT_DURATION=30000000
MLC=0.001
MOE_TRAIN_CAP_FACTOR=1.0
MOE_EVAL_CAP_FACTOR=1.0
MOE_MIN_CAP=4
MOE_DROP_TOKEN="true"
CL_ENABLED="false"
CL_START_SEQLEN=80
CL_AVG_SEQLEN=$(( (CL_START_SEQLEN + SEQ_LEN) / 2 ))
CL_TOKENS=60
CL_TOKENS=$((CL_TOKENS * 1000000000))
CL_STEP=$(( CL_TOKENS / (GLOBAL_BATCH_SIZE * CL_AVG_SEQLEN) ))
LOG_INTERVAL=1
EVAL_ITERS=0
EVAL_INTERVAL=300
SAVE_INTERVAL=60
INIT_STD=0.014

current_time=$(date "+%Y.%m.%d-%H.%M.%S")
host="${HOSTNAME}"
NAME="gpt-${MODEL_SIZE}B-lr-${LR}-minlr-${MIN_LR}-bs-${GLOBAL_BATCH_SIZE}-gpus-${TOTAL_GPUS}-mp-${MP_SIZE}-pp-${PP_SIZE}-test"
if [[ $EP_SIZE -gt 1 ]]; then
    NAME="${NAME}-ep-${EP_SIZE}-mlc-${MLC}-cap-${MOE_TRAIN_CAP_FACTOR}-drop-${MOE_DROP_TOKEN}"
fi
if [ "${CL_ENABLED}" = "true" ]; then
    NAME="${NAME}-cl-${CL_START_SEQLEN}-${CL_STEP}"
fi

OUTPUT_BASEPATH=$DIR/output
mkdir -p "${OUTPUT_BASEPATH}/tensorboard/"
mkdir -p "${OUTPUT_BASEPATH}/checkpoint/"
mkdir -p "${OUTPUT_BASEPATH}/log/"
TENSORBOARD_DIR="${OUTPUT_BASEPATH}/tensorboard/${NAME}_${host}_${current_time}"
mkdir -p ${TENSORBOARD_DIR}

# --- Megatron & Deepspeed Options ---
data_options=" \
         --tokenizer-type GPT2BPETokenizer \
         --vocab-file ${VOCAB_FILE} \
         --merge-file ${MERGE_FILE} \
         --data-path ${DATA_PATH}"

# NOTE: --using-torchrun is the ONE addition vs the SLURM template. It sets
# args.using_mpi=False in megatron/arguments.py, so rank/world come from the
# RANK/WORLD_SIZE env vars torchrun sets, and mpi4py is never imported.
megatron_options=" \
        --moe-expert-parallel-size ${EP_PARALLEL_SIZE} \
        --num-experts ${EP_SIZE} \
        --moe-loss-coeff ${MLC} \
        --moe-train-capacity-factor ${MOE_TRAIN_CAP_FACTOR} \
        --moe-eval-capacity-factor ${MOE_EVAL_CAP_FACTOR} \
        --moe-min-capacity ${MOE_MIN_CAP} \
        --override-opt_param-scheduler \
        --adam-beta1 0.9 \
        --adam-beta2 0.95 \
        --tensor-model-parallel-size ${MP_SIZE} \
        --init-method-std ${INIT_STD} \
        --lr-decay-tokens ${LR_DECAY_TOKENS} \
        --lr-warmup-tokens ${WARMUP_TOKENS} \
        --micro-batch-size ${BATCH_SIZE} \
        --exit-duration-in-mins ${EXIT_DURATION} \
        --global-batch-size ${GLOBAL_BATCH_SIZE} \
        --num-layers ${NUM_LAYERS} \
        --hidden-size ${HIDDEN_SIZE} \
        --ffn-hidden-size ${FFN_HIDDEN_SIZE} \
        --num-attention-heads ${NUM_ATTN_HEADS} \
        --seq-length ${SEQ_LEN} \
        --max-position-embeddings ${SEQ_LEN} \
        --train-tokens ${TRAIN_TOKENS} \
        --train-iters ${TRAIN_ITERS} \
        --lr ${LR} \
        --min-lr ${MIN_LR} \
        --lr-decay-style cosine \
        --split 98,2,0 \
        --log-interval ${LOG_INTERVAL} \
        --eval-interval ${EVAL_INTERVAL} \
        --eval-iters ${EVAL_ITERS} \
        --save-interval ${SAVE_INTERVAL} \
        --weight-decay 0.1 \
        --clip-grad 1.0 \
        --hysteresis 2 \
        --num-workers 0 \
        --bf16 \
        --tensorboard-queue-size 1 \
        --log-timers-to-tensorboard \
        --log-batch-size-to-tensorboard \
        --log-validation-ppl-to-tensorboard \
        --tensorboard-dir ${TENSORBOARD_DIR} \
        --moe-train-capacity-factor 1.25 \
	    --expert-interval 1 \
	    --topk $topk \
        --use-flash-attn-v2 \
        --adam-eps 1e-8 \
        --seed 1000 \
        --using-torchrun \
	--use-rotary-position-embeddings"

# --- Conditional Logic (identical to the SLURM template) ---
if [[ ${PP_SIZE} -gt 1 ]]; then
    WALL_CLOCK_BREAKDOWN="false"
    export WALL_CLOCK_BREAKDOWN="false"
else
    if [[ "$COLLECT_PROFILING_CACHE" == "true" ]]; then
        WALL_CLOCK_BREAKDOWN="true"
        export WALL_CLOCK_BREAKDOWN="true"
    else
        WALL_CLOCK_BREAKDOWN="false"
        export WALL_CLOCK_BREAKDOWN="false"
    fi
fi

if [[ "${MOE_TYPE}" == "X-MOE" ]]; then
    megatron_options="${megatron_options} --use-uneven-all-to-all --use-pft --no-bias-gelu-fusion"
elif [[ "${MOE_TYPE}" == "X-MOE-4D" ]]; then
    megatron_options="${megatron_options} --use-uneven-all-to-all --use-pft --no-bias-gelu-fusion"

elif [[ "${MOE_TYPE}" == "X-MOE-4D-GroupedGEMM-triton" ]]; then
    megatron_options="${megatron_options} --use-uneven-all-to-all --use-pft --use-groupedGEMM --use-triton --no-bias-gelu-fusion"
    export USE_TRITON_GROUPGEMM="True"

elif [[ "${MOE_TYPE}" == "X-MOE-4D-GroupedGEMM-primus" ]]; then
    export USE_AITER_GROUPGEMM=True
    megatron_options="${megatron_options} --use-uneven-all-to-all --use-pft --use-groupedGEMM --no-bias-gelu-fusion --disable-bias-linear"

elif [[ "${MOE_TYPE}" == "TED-MOE" ]]; then
    megatron_options="${megatron_options} --enable-expert-tensor-parallelism"

elif [[ "${MOE_TYPE}" == "TUTEL-MOE" ]]; then
    megatron_options="${megatron_options} --use-tutel"

elif [[ "${MOE_TYPE}" == "DENSE" ]]; then
    megatron_options="${megatron_options} --num-key-value-heads ${KV_HEADS} --swiglu  --normalization rmsnorm --disable-bias-linear --no-bias-gelu-fusion  --untie-embeddings-and-output-weights"
fi

export LAYER_TIMING=0
export LAYER_TIMING_TARGETS=0

if [ "${ACTIVATION_CHECKPOINT}" = "true" ]; then
    megatron_options="${megatron_options} --checkpoint-activations"
    megatron_options="${megatron_options} --checkpoint-num-layers $CHECKPOINT_NUM_LAYERS"
fi
if [[ $EP_SIZE -gt 1 ]]; then
    megatron_options="${megatron_options} --create-moe-param-group"
fi
if [ "${MOE_DROP_TOKEN}" = "false" ]; then
    megatron_options="${megatron_options} --disable-moe-token-dropping"
fi
# ================================================== END of Megatron Setup =============================================================


# ================================================== DeepSpeed Setup =============================================================
template_json="../ds_config_gpt_TEMPLATE.json"
config_dir="temp_ds_json"
config_json="${config_dir}/ds_config_gpt_Zero0_${NAME}.json"
mkdir -p "${config_dir}"

sed "s/CONFIG_BATCH_SIZE/${GLOBAL_BATCH_SIZE}/" ${template_json} \
    | sed "s/CONFIG_MBSIZE/${BATCH_SIZE}/" \
    | sed "s/LOG_INTERVAL/${LOG_INTERVAL}/" \
    | sed "s/ZERO_STAGE/{{ZERO}}/" \
    | sed "s/PRESCALE_GRAD/false/" \
    | sed "s/CONFIG_FP16_ENABLED/false/" \
    | sed "s/CONFIG_BF16_ENABLED/true/" \
    | sed "s/CONFIG_CL_ENABLED/${CL_ENABLED}/" \
    | sed "s/CONFIG_CL_MIN/${CL_START_SEQLEN}/" \
    | sed "s/CONFIG_CL_MAX/${SEQ_LEN}/" \
    | sed "s/CONFIG_CL_DURATION/${CL_STEP}/" \
    | sed "s/WALL_CLOCK_BREAKDOWN/${WALL_CLOCK_BREAKDOWN}/" \
    > ${config_json}

deepspeed_options=" --deepspeed --deepspeed_config ${config_json}"
if [[ $PP_SIZE -gt 1 ]]; then
    deepspeed_options=" ${deepspeed_options} --pipeline-model-parallel-size ${PP_SIZE}"
else
    deepspeed_options=" ${deepspeed_options} --no-pipeline-parallel"
fi

if [ "${ACTIVATION_CHECKPOINT}" = "true" ]; then
    deepspeed_options="${deepspeed_options} --deepspeed-activation-checkpointing"
fi
# ================================================== END of DeepSpeed Setup =============================================================


# ================================================== Global Env Var Setup =============================================================
export CUDA_DEVICE_MAX_CONNECTIONS=1

# ELM_PP_launch.py reads its planner topology from these. torchrun does not set
# them, so we provide them explicitly. This is what lets the non-SLURM path work
# WITHOUT modifying any shared file.
# NEVER export SLURM_PROCID / SLURM_LOCALID here — see porting note #4 above.
export SLURM_NTASKS=${TOTAL_GPUS}
export SLURM_NNODES=${NODES}

# Portable NCCL/torch settings. Site/network-specific ones (interface names,
# libfabric/CXI tuning, proxies, RCCL plugin) belong in env.sh — see env.sh.example.
export TRITON_PTXAS_NUM_WORKERS=1
export OMP_NUM_THREADS=1
export NCCL_TIMEOUT=1200
export NCCL_TIMEOUT_MS=1200000
export TORCH_NCCL_BLOCKING_WAIT=1
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1
export NCCL_ASYNC_ERROR_HANDLING=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export NCCL_DEBUG=INFO

# Every global var above that must ALSO reach a remote node.
#
# THE BUG THIS FIXES: for NODES=1 the launcher runs `bash node_launch.sh`, which
# inherits this shell -- so all of these are present. For NODES>1 it runs
# `ssh <host> "bash node_launch.sh"`, and **ssh carries no environment**. Only the
# four vars node_launch.sh exports explicitly survived; the rest were silently
# dropped on EVERY node. Multi-node runs therefore executed with different settings
# than single-node ones -- no expandable_segments (so more fragmentation and
# earlier OOM), no NCCL_DEBUG (so no diagnostics when it failed), no NCCL timeouts,
# and no CUDA_DEVICE_MAX_CONNECTIONS -- while appearing to be the same config.
# Keeping ONE list here and generating the exports from it stops the two drifting.
XMOE4D_PROPAGATE_VARS=(
    CUDA_DEVICE_MAX_CONNECTIONS TRITON_PTXAS_NUM_WORKERS OMP_NUM_THREADS
    NCCL_TIMEOUT NCCL_TIMEOUT_MS TORCH_NCCL_BLOCKING_WAIT
    TORCH_NCCL_ASYNC_ERROR_HANDLING NCCL_ASYNC_ERROR_HANDLING
    PYTORCH_CUDA_ALLOC_CONF NCCL_DEBUG
)

gpus_per_node=$(( TOTAL_GPUS / NODES ))

# --- Host list & master address (hostfile replaces scontrol/SLURM_NODELIST) ---
HOSTS=()
if [[ ${NODES} -gt 1 ]]; then
    if [[ ! -f "${HOSTFILE}" ]]; then
        echo "FATAL: NODES=${NODES} but no hostfile at '${HOSTFILE}'. See hostfile.example." >&2
        exit 1
    fi
    while read -r h; do
        [[ -z "$h" || "$h" =~ ^# ]] && continue
        HOSTS+=("$h")
    done < "${HOSTFILE}"
    if [[ ${#HOSTS[@]} -ne ${NODES} ]]; then
        echo "FATAL: hostfile has ${#HOSTS[@]} hosts but NODES=${NODES}." >&2
        exit 1
    fi
    export MASTER_ADDR="${MASTER_ADDR:-${HOSTS[0]}}"
else
    HOSTS=("localhost")
    export MASTER_ADDR="${MASTER_ADDR:-127.0.0.1}"
fi
export MASTER_PORT

echo "--- Distributed Training Setup (torchrun) ---"
echo "NODES=${NODES}  gpus_per_node=${gpus_per_node}  TOTAL_GPUS=${TOTAL_GPUS}"
echo "MASTER_ADDR=${MASTER_ADDR}:${MASTER_PORT}"
echo "HOSTS: ${HOSTS[*]}"
echo "--------------------------------------------"
# ================================================== END of Global Env Var Setup =============================================================


# ================================================== Analysis (verbatim from the SLURM template) ==================================
_ANALYSIS_DONE=0
run_analysis() {
    [ "${_ANALYSIS_DONE}" -eq 1 ] && return 0
    _ANALYSIS_DONE=1

    echo "--- Starting Log Analysis ---"

    # 1. Define Paths
    LAST_RANK=$(( TOTAL_GPUS - 1 ))
    RANK_LOG_FILE="${JOB_DIR}/rank_${LAST_RANK}.log"
    RANK_LOG_FILE_2="${JOB_DIR}/rank_0.log"
    # Written by autorun.sh's `tee` (the .o equivalent). analyze_memory.py needs it
    # to read TOTAL_GPUS; without it the per-stage memory table is lost.
    SLURM_LOG_FILE="${JOB_DIR}/a-xmoe-${RUN_TYPE}-${JOB_ID}.o"

    # 2. Define the Merged Log Path (Keeping it permanent)
    MERGED_LOG="${JOB_DIR}/full_run.log"

    # 3. Wait a moment for file system sync
    sleep 5

    # 4. Create the Merged Log
    if [ -f "${SLURM_LOG_FILE}" ]; then
        cat "${SLURM_LOG_FILE}" > "${MERGED_LOG}"
    else
        echo "Warning: driver .o file not found at ${SLURM_LOG_FILE}" > "${MERGED_LOG}"
    fi

    echo -e "\n\n==========================================================\n" >> "${MERGED_LOG}"
    echo -e "--- RANK ${LAST_RANK} METRICS (LOSS/TFLOPS) BELOW ---\n" >> "${MERGED_LOG}"
    echo -e "==========================================================\n" >> "${MERGED_LOG}"

    if [ -f "${RANK_LOG_FILE_2}" ]; then
        cat "${RANK_LOG_FILE_2}" >> "${MERGED_LOG}"
    else
        echo "Error: Rank log file not found at ${RANK_LOG_FILE_2}" >> "${MERGED_LOG}"
    fi
    if [ -f "${RANK_LOG_FILE}" ]; then
        cat "${RANK_LOG_FILE}" >> "${MERGED_LOG}"
    else
        echo "Error: Rank log file not found at ${RANK_LOG_FILE}" >> "${MERGED_LOG}"
    fi

    echo "Merged log saved to: ${MERGED_LOG}"

    # 5. Run Analysis on the MERGED file
    python ../utils/analyze_log.py \
            "${MERGED_LOG}" \
            --iterations $TRAIN_ITERS \
            --nodes $NODES \
            --gpus_per_node $gpus_per_node \
            --pp $PP_SIZE \
            --ep $EP_PARALLEL_SIZE \
            --dp $(( TOTAL_GPUS / PP_SIZE / MP_SIZE )) \
            --tp $MP_SIZE \
            --gbs $GLOBAL_BATCH_SIZE \
            --mbs $BATCH_SIZE \
            --slurm_job_id $JOB_ID \
            --seqlen $SEQ_LEN \
            --num_layers $NUM_LAYERS \
            --num_experts $EP_SIZE \
            --expert_dim $FFN_HIDDEN_SIZE \
            --topk $topk \
            --hidden_dim $HIDDEN_SIZE \
            --moe_type $MOE_TYPE \
            --model_size $MODEL_SIZE \
            --activation_checkpointing $ACTIVATION_CHECKPOINT \
            --checkpoint_interval $CHECKPOINT_NUM_LAYERS \
            --dynamic_checkpoint $DYNAMIC_CHECKPOINT \
            --uneven_pp $UNEVEN_PP \
            --zero $ZERO_STAGE ${ANALYZE_LOG_PROFILING_FLAG} >> "${MERGED_LOG}"
    _LOG_RC=$?

    python ../utils/analyze_memory.py "${MERGED_LOG}"
    _MEM_RC=$?

    # Report per-step status instead of an unconditional "Analysis Complete".
    #
    # WHY: analyze_log.py's stdout is redirected into ${MERGED_LOG}, so when it dies
    # the only trace is a stderr traceback buried in the driver .o -- while this
    # function still cheerfully printed "Analysis Complete". A missing `pandas` or
    # `openpyxl` therefore silently discarded the ENTIRE throughput/TFLOPs analysis
    # of a run that had otherwise succeeded, and the loss was only noticed by a human
    # wondering why the numbers were missing. Never claim success we did not verify.
    if [ "${_LOG_RC}" -ne 0 ]; then
        echo "ERROR: analyze_log.py FAILED (rc=${_LOG_RC}) — throughput/TFLOPs analysis is MISSING." >&2
        echo "       Its traceback is in ${SLURM_LOG_FILE} (stdout went to the merged log)." >&2
        echo "       Usually a missing dep:  pip install pandas openpyxl" >&2
        echo "       Re-run analysis WITHOUT retraining:" >&2
        echo "         python ../utils/rerun_analysis.py ${SLURM_LOG_FILE}" >&2
    fi
    [ "${_MEM_RC}" -ne 0 ] && \
        echo "ERROR: analyze_memory.py FAILED (rc=${_MEM_RC}) — per-stage memory table is MISSING." >&2

    if [ "${_LOG_RC}" -eq 0 ] && [ "${_MEM_RC}" -eq 0 ]; then
        echo "Analysis Complete. Full log: ${MERGED_LOG}"
    else
        echo "Analysis INCOMPLETE (see errors above). Partial log: ${MERGED_LOG}"
    fi
}
# ================================================== END of Analysis ==================================


# ================================================== Monitor Run (py-spy) ==================================
# Async pipeline-stall monitor (body lives in monitor_run.sh, same dir) — the torchrun counterpart
# of the SLURM template's monitor block. Backgrounded so it never blocks training. Writes:
#   ${JOB_DIR}/a-monitor.txt   — SUMMARY: per-interval state histogram across ALL ranks + LIVE x/world
#                                liveness + frozen/odd counts + culprit native stack. Read this first.
#   ${JOB_DIR}/monitor/node{i}.txt — per-node detail (STATUS RANK GPU PID WATTS HBM% RAM_GB TRACE)
#   ${JOB_DIR}/monitor/monitor.tsv — one row per (interval,rank) for grep/plot
# Needs py-spy on PATH or ~/.local/bin/py-spy, on EVERY node (`pip install py-spy`), and
# /proc/sys/kernel/yama/ptrace_scope = 0. Skipped with a warning when absent — never fatal.
# Disable with:  XMOE4D_MONITOR=0 bash autorun.sh
XMOE4D_MONITOR="${XMOE4D_MONITOR:-1}"
MON_FAST="${MON_FAST:-60}"; MON_SLOW="${MON_SLOW:-180}"; MON_WINDOW="${MON_WINDOW:-300}"; MON_TRACE_FRAMES="${MON_TRACE_FRAMES:-20}"
MONITOR_PID=""
if [[ "${XMOE4D_MONITOR}" == "1" ]]; then
    if [[ ! -f "${DIR}/monitor_run.sh" ]]; then
        echo "[monitor] monitor_run.sh not found in ${DIR} — skipping."
    elif ! command -v py-spy >/dev/null 2>&1 && [ ! -x "${HOME}/.local/bin/py-spy" ]; then
        echo "[monitor] py-spy not found — skipping. Enable with: pip install py-spy"
    else
        JOB_ID="${JOB_ID}" NODES="${NODES}" TOTAL_GPUS="${TOTAL_GPUS}" HOSTFILE="${HOSTFILE}" \
            bash "${DIR}/monitor_run.sh" "${JOB_DIR}" "${MON_FAST}" "${MON_SLOW}" "${MON_WINDOW}" "${MON_TRACE_FRAMES}" &
        MONITOR_PID=$!
        trap 'kill ${MONITOR_PID} 2>/dev/null' EXIT
        echo "[monitor] pid ${MONITOR_PID} -> ${JOB_DIR}/a-monitor.txt (+ monitor/); ${MON_FAST}s for first ${MON_WINDOW}s, then ${MON_SLOW}s"
    fi
fi
# ================================================== END of Monitor Run ==================================


# ================================================== Launch X-MoE-4D Training (torchrun) =============================================================
if [[ "$COLLECT_PROFILING_CACHE" == "true" ]]; then
    export to_profile="False"
    export profile_memory="False"
else
    export to_profile="False"
    export profile_memory="False"
fi
export profile_dir="${JOB_DIR}/torch_profile"

planner_mode="{{RUN_PLANNER}}"
if [[ "$planner_mode" != "true" && "$planner_mode" != "true-membal" ]]; then
    planner_mode="false"
fi

# (a) Per-RANK command. torchrun (--no-python) executes this once per worker with
#     RANK / LOCAL_RANK / WORLD_SIZE set, so ${RANK} below expands per worker.
RANK_CMD="${JOB_DIR}/rank_cmd.sh"
cat > "${RANK_CMD}" <<EOF
#!/bin/bash
exec python ../ELM_PP_launch.py \\
    --run-planner ${planner_mode} \\
    --planner-profile-dir ./planner_profiling_cache \\
    --planner-memory-headroom-gb ${PLANNER_MEMORY_HEADROOM_GB} \\
    ${megatron_options} \\
    ${data_options} \\
    ${deepspeed_options} \\
    --master-addr=${MASTER_ADDR} \\
    --zero-stage {{ZERO}} \\
    > "${DIR}/${JOB_DIR}/rank_\${RANK}.log" 2>&1
EOF
chmod +x "${RANK_CMD}"

# (b) Per-NODE launcher. Run locally on 1 node, or via ssh on each host.
#     ssh does NOT carry the environment, so env.sh is sourced here.
if [[ ${NODES} -eq 1 ]]; then
    TORCHRUN_ARGS="--standalone --nnodes 1 --nproc_per_node ${gpus_per_node}"
else
    TORCHRUN_ARGS="--nnodes ${NODES} --nproc_per_node ${gpus_per_node} \
--rdzv_backend c10d --rdzv_endpoint ${MASTER_ADDR}:${MASTER_PORT} --rdzv_id ${JOB_ID}"
fi

NODE_LAUNCH="${JOB_DIR}/node_launch.sh"
{
    echo '#!/bin/bash'
    echo "cd \"${DIR}\" || exit 1"
    echo "# Driver globals, re-exported because ssh carries no environment."
    echo "# Emitted BEFORE env.sh so a site file can still override them."
    for _v in "${XMOE4D_PROPAGATE_VARS[@]}"; do
        [ -n "${!_v+x}" ] && printf 'export %s=%q\n' "$_v" "${!_v}"
    done
    echo "if [ -f \"${XMOE4D_ENV_FILE}\" ]; then source \"${XMOE4D_ENV_FILE}\"; fi"
} > "${NODE_LAUNCH}"
cat >> "${NODE_LAUNCH}" <<EOF
# Topology for ELM_PP_launch.py's planner (torchrun does not set these).
export SLURM_NTASKS=${TOTAL_GPUS}
export SLURM_NNODES=${NODES}
export MASTER_ADDR="${MASTER_ADDR}"
export MASTER_PORT="${MASTER_PORT}"
exec torchrun ${TORCHRUN_ARGS} --no-python bash "${DIR}/${RANK_CMD}"
EOF
chmod +x "${NODE_LAUNCH}"

echo "--- Launching training at: $(date '+%F %T') ---"
if [[ ${NODES} -eq 1 ]]; then
    bash "${NODE_LAUNCH}"
    TRAIN_RC=$?
else
    PIDS=()
    for h in "${HOSTS[@]}"; do
        echo "[launch] ssh ${h} -> ${NODE_LAUNCH}"
        ssh -o BatchMode=yes "${h}" "bash '${DIR}/${NODE_LAUNCH}'" &
        PIDS+=($!)
    done
    TRAIN_RC=0
    for p in "${PIDS[@]}"; do
        wait "$p" || TRAIN_RC=$?
    done
fi
echo "--- Training finished (rc=${TRAIN_RC}) at: $(date '+%F %T') ---"
# ================================================== END of Launch =============================================================


# ================================================== Run Analysis =============================================================
# No SLURM wall clock off-scheduler, so no SIGUSR1 guard is needed: analysis simply
# runs here on both the success and the failure path (there is no `set -e`).
run_analysis
# ================================================== END of Run Analysis =============================================================

exit ${TRAIN_RC}
