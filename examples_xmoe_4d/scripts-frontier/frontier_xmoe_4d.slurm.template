#!/bin/bash

# --- 1. Templatized SLURM Header ---
#SBATCH -A gen150
#SBATCH -J {{MODEL_SIZE}}-{{RUN_TYPE}}-nbs{{NUM_BATCHES}}
#SBATCH -o logs/job_%j_pp{{PP_SIZE}}_ep{{EP_PARALLEL_SIZE}}_{{MOE_TYPE}}_ckpt_{{ACTIVATION_CHECKPOINT}}_planner_{{RUN_PLANNER}}/a-xmoe-{{RUN_TYPE}}-%j.o
#SBATCH -e logs/job_%j_pp{{PP_SIZE}}_ep{{EP_PARALLEL_SIZE}}_{{MOE_TYPE}}_ckpt_{{ACTIVATION_CHECKPOINT}}_planner_{{RUN_PLANNER}}/a-xmoe-{{RUN_TYPE}}-%j.e
#SBATCH -t 0:10:00
#SBATCH -p {{PARTITION}}
#SBATCH -N {{NODES}}
#SBATCH -d singleton
# [TIMEOUT-SAFE ANALYSIS — added] Ask SLURM to send SIGUSR1 to THIS batch shell (B:)
# 180s before the walltime, so run_analysis() can run before the job is killed.
# Requires the backgrounded srun + `wait` in the Launch section below.
#SBATCH --signal=B:USR1@180
#a SBATCH -q debug
#a SBATCH -p extended
#a --switches=1@00:20:00
#a --contiguous
####RUN_LOG_DIR="logs/job_${SLURM_JOB_ID}"
##SBATCH -o logs/xmoe-{{RUN_TYPE}}-%j.o
##SBATCH -e logs/xmoe-{{RUN_TYPE}}-%j.e

# 01141-01142,02548,02551,02556,02676-02679

# --- 2. Templatized Variable Definitions ---
BATCH_SIZE={{BATCH_SIZE}}
NUM_BATCHES={{NUM_BATCHES}}
PP_SIZE={{PP_SIZE}}
EP_PARALLEL_SIZE={{EP_PARALLEL_SIZE}}
MP_SIZE={{MP_SIZE}}
NODES={{NODES}}
TOTAL_GPUS={{TOTAL_GPUS}}
